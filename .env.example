# Copy to .env (never commit .env). On Render, set these as environment variables.
# production: refuses to start with weak secrets or http origins, hides /docs.
ENVIRONMENT=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
FRONTEND_ORIGINS=http://localhost:5173
# Signs the access tokens (JWT). 32+ random characters, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars
# Separate AI service (only the backend calls it):
AI_SERVICE_URL=http://localhost:8001
# 32+ characters, the same value in both services. Only signed tokens travel, never the key.
AI_SERVICE_KEY=the-same-32-plus-char-secret-configured-in-the-ai-service

# Number of proxies in front of the API (Render: 1). Used to read the real client IP for rate limits.
TRUSTED_PROXY_HOPS=0

# Optional: throw-away database for the SQL integration tests (never production)
# TEST_DATABASE_URL=
